{
  "Comment": "StartTech CloudWatch Dashboard – replace <ALB_ARN_SUFFIX>, <TG_ARN_SUFFIX>, and <ASG_NAME> with actual values from terraform output.",
  "widgets": [
    {
      "type": "metric",
      "x": 0,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "ALB – Request Count",
        "region": "us-east-1",
        "metrics": [
          ["AWS/ApplicationELB", "RequestCount", "LoadBalancer", "<ALB_ARN_SUFFIX>"]
        ],
        "period": 300,
        "stat": "Sum",
        "view": "timeSeries",
        "yAxis": { "left": { "min": 0 } }
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "ALB – 5XX Errors",
        "region": "us-east-1",
        "metrics": [
          ["AWS/ApplicationELB", "HTTPCode_ELB_5XX_Count", "LoadBalancer", "<ALB_ARN_SUFFIX>", { "label": "ALB 5XX" }],
          ["AWS/ApplicationELB", "HTTPCode_Target_5XX_Count", "LoadBalancer", "<ALB_ARN_SUFFIX>", { "label": "Target 5XX" }]
        ],
        "period": 300,
        "stat": "Sum",
        "view": "timeSeries",
        "annotations": {
          "horizontal": [{ "label": "Alarm threshold", "value": 10, "color": "#d62728" }]
        }
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 6,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "ALB – Target Response Time (p99)",
        "region": "us-east-1",
        "metrics": [
          ["AWS/ApplicationELB", "TargetResponseTime", "LoadBalancer", "<ALB_ARN_SUFFIX>", "TargetGroup", "<TG_ARN_SUFFIX>", { "stat": "p99" }],
          ["AWS/ApplicationELB", "TargetResponseTime", "LoadBalancer", "<ALB_ARN_SUFFIX>", "TargetGroup", "<TG_ARN_SUFFIX>", { "stat": "Average", "label": "Average" }]
        ],
        "period": 300,
        "view": "timeSeries",
        "annotations": {
          "horizontal": [{ "label": "SLO (2s)", "value": 2, "color": "#d62728" }]
        }
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 6,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "EC2 – CPU Utilization (ASG Average)",
        "region": "us-east-1",
        "metrics": [
          ["AWS/EC2", "CPUUtilization", "AutoScalingGroupName", "<ASG_NAME>"]
        ],
        "period": 300,
        "stat": "Average",
        "view": "timeSeries",
        "annotations": {
          "horizontal": [{ "label": "Scale-out threshold", "value": 80, "color": "#d62728" }]
        }
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 12,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "ElastiCache – Cache Hit Rate",
        "region": "us-east-1",
        "metrics": [
          ["AWS/ElastiCache", "CacheHits", "CacheClusterId", "starttech-redis-0001-001"],
          ["AWS/ElastiCache", "CacheMisses", "CacheClusterId", "starttech-redis-0001-001"]
        ],
        "period": 300,
        "stat": "Sum",
        "view": "timeSeries"
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 12,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "ElastiCache – CPU Utilization",
        "region": "us-east-1",
        "metrics": [
          ["AWS/ElastiCache", "EngineCPUUtilization", "CacheClusterId", "starttech-redis-0001-001"]
        ],
        "period": 300,
        "stat": "Average",
        "view": "timeSeries"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 18,
      "width": 24,
      "height": 6,
      "properties": {
        "title": "Backend Application – Recent Errors",
        "region": "us-east-1",
        "query": "SOURCE '/starttech/backend/application' | fields @timestamp, @message | filter @message like /ERROR/ | sort @timestamp desc | limit 50",
        "view": "table"
      }
    }
  ]
}
